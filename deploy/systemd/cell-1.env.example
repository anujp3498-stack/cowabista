# /etc/cowabista/cell-cell-1.env  (root:cowabista, mode 0640). Cell 1 = phones 1-4. All values are required unless
# marked optional; the guard refuses to start on a missing one. Secrets live only in this file.
CAMPAIGN_TRANSPORT_PHONE_IDS=1-4
PORT=8080
DATABASE_URL=postgresql://cowabista:CHANGE_ME@host-s:5432/cowabista
CAMPAIGN_REDIS_URL=redis://:CHANGE_ME@host-s:6379
# Authentication and provider integration used by the HTTP side of the same process (see docs/DEVELOPMENT.md).
# Better Auth: the SAME secret on every cell (openssl rand -base64 32); the public https origin of the app.
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://app.example.com
META_APP_SECRET=CHANGE_ME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
# Campaign media (optional; without it media uploads answer 503). Same bucket and keys on every cell.
# CAMPAIGN_MEDIA_STORAGE=s3
# CAMPAIGN_MEDIA_S3_ENDPOINT=https://minio.internal:9000
# CAMPAIGN_MEDIA_S3_BUCKET=wabista-media
# CAMPAIGN_MEDIA_S3_ACCESS_KEY_ID=CHANGE_ME
# CAMPAIGN_MEDIA_S3_SECRET_ACCESS_KEY=CHANGE_ME
# Make the guard also require the auth/provider variables above (space-separated names). Optional but recommended.
CAMPAIGN_CELL_REQUIRED_ENV=BETTER_AUTH_SECRET BETTER_AUTH_URL META_APP_SECRET WHATSAPP_WEBHOOK_VERIFY_TOKEN
# CORS_ALLOWED_ORIGINS (optional) takes comma-separated FULL origins, e.g. https://app.example.com; since
# 2026-10-20 a bare host name or any other malformed entry stops the process at startup. TRUST_PROXY (optional)
# is the number of reverse-proxy hops in front of this process, default 1.
# Optional: CORS_ALLOWED_ORIGINS, TRUST_PROXY, LOG_LEVEL, API_RATE_LIMIT_MAX_PER_MINUTE, CAMPAIGN_PLATFORM_MAX_TPS,
# CAMPAIGN_TRANSPORT_SHARDS (default 8, max 16; leave at the default: the measured configuration used it),
# CAMPAIGN_CELL_WAIT_SECONDS (guard's wait for PostgreSQL/Redis, default 60).
