# Wabista Nexus: generic single-origin reverse proxy (example; adapt names, paths and TLS to the host).
#
# The SPA calls the API with relative /api/... URLs, so both must be served on ONE origin:
#   /        the built SPA (artifacts/wabista-nexus/dist/public), with history fallback to index.html
#   /api/    the API server (artifacts/api-server, `pnpm --filter @workspace/api-server run start`), prefix kept
#
# Build the SPA with BASE_PATH=/ (the default; no authentication build variables):
# `pnpm --filter @workspace/wabista-nexus run build`. Sign-in is served by the API at /api/auth/* (Better Auth),
# so set BETTER_AUTH_URL=https://app.example.com (this origin) for the API.
# The API needs no CORS entry for this layout (same origin). Keep TRUST_PROXY=1 (the default) for one nginx
# hop in front of the API so rate limiting sees the real client address, and keep the API port (8080)
# unreachable from outside this host, or clients could bypass nginx and forge X-Forwarded-For.
# See docs/DEVELOPMENT.md.
#
# Install as e.g. /etc/nginx/sites-available/wabista.conf, symlink into sites-enabled, `nginx -t`, reload.

upstream wabista_api {
    # One API process. With several processes list each one; the API keeps no per-process session state.
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;
    return 301 https://$host$request_uri;
}

server {
    # nginx >= 1.25.1 prefers `listen 443 ssl;` plus `http2 on;`; this form also works on older releases.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.com;

    ssl_certificate     /etc/ssl/certs/app.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/app.example.com.key;

    root /opt/wabista/artifacts/wabista-nexus/dist/public;
    index index.html;

    # --- API --------------------------------------------------------------------------------------------
    # `proxy_pass` without a URI part forwards the original path unchanged, so /api/... reaches the API as
    # /api/... (the API mounts every route under /api). `location = /api` covers the bare path.
    location /api/ {
        proxy_pass http://wabista_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # Contact imports stream large CSV bodies (the API caps them itself); stream them through instead
        # of spooling to disk first. Long-running exports and uploads need generous timeouts.
        client_max_body_size 6g;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Sign-in, sign-up and sign-out take small JSON bodies only (the API refuses anything else); do not let
    # the 6g import limit above apply to them.
    location /api/auth/ {
        proxy_pass http://wabista_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 64k;
    }

    # The public invite preview carries the invitation token in its path, and the token (with the invited
    # email) is enough to join: keep it out of the access log. (nginx's error log still records the request
    # line of a failed upstream request; keep that log as restricted as the access log.)
    location /api/invite-info/ {
        access_log off;
        proxy_pass http://wabista_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api {
        proxy_pass http://wabista_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # --- SPA --------------------------------------------------------------------------------------------
    # Fingerprinted build output: safe to cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # index.html must be revalidated so a new deploy is picked up immediately. Referrer-Policy (also a
    # <meta> in index.html): invite links carry a token in the URL, so requests send only the origin.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "strict-origin" always;
    }

    # Invite links (/invite/<token>) and the sign-in/sign-up pages they lead to (?invite=<token>&email=...)
    # carry a credential in the URL: serve the SPA shell directly (no internal redirect to a logged
    # location) and do not log them.
    location /invite/ {
        access_log off;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "strict-origin" always;
        try_files /index.html =404;
    }
    location ~ ^/sign-(in|up)(/|$) {
        access_log off;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "strict-origin" always;
        try_files /index.html =404;
    }

    # Client-side routes (/campaigns/..., /api-developers, ...) fall back to the SPA shell. Note that
    # /api-developers is an SPA route, not an API path: only /api and /api/... go to the API above.
    location / {
        add_header Referrer-Policy "strict-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
