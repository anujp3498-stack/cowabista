# Wabista Nexus: local development environment (PLACEHOLDERS ONLY; never commit real values).
# Copy to .env (git-ignored) and edit. Read by the API dev server (`pnpm --filter @workspace/api-server run dev`),
# the Vite dev server and build, Playwright, and the guarded database commands in lib/db. The API `start` script
# and the API test suites read only the shell environment. See docs/DEVELOPMENT.md.
#
# NODE_ENV is intentionally NOT set here: the API dev script sets NODE_ENV=development itself, and a
# NODE_ENV in a sourced .env would turn `vite build` into a non-production build.

# --- Database (required) ---------------------------------------------------------------------------------
# A disposable LOCAL PostgreSQL 16 database only. Never the production database (cowabista), never Host S,
# never a benchmark database (any name containing "bench"). The schema commands refuse all of those.
DATABASE_URL=postgresql://wabista:CHANGE_ME@localhost:5432/wabista_dev
# Required by schema-changing commands (db push, apply-sql, reset-disposable-local); they refuse without it.
# Give it per command (`WABISTA_DB_TARGET=disposable-local pnpm --filter @workspace/db run push`) so that the
# opt-in stays deliberate; uncomment only if DATABASE_URL above is a disposable local database.
# WABISTA_DB_TARGET=disposable-local
# Optional guard tuning (comma-separated). Approved non-loopback development hosts must be listed explicitly.
# WABISTA_DB_APPROVED_DEV_HOSTS=
# WABISTA_DB_DENY_HOSTS=
# WABISTA_DB_DENY_NAMES=

# --- API server (optional) -------------------------------------------------------------------------------
# Default 8080. If you change it, set API_PROXY_TARGET below to match.
# PORT=8080
# Default info.
# LOG_LEVEL=info
# Comma-separated FULL origins (scheme://host[:port]) of cross-origin browser callers. Not needed when the
# SPA and API share one origin (the Vite /api proxy in development, a reverse proxy in production).
# A malformed entry stops the server at startup.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Number of reverse-proxy hops in front of the API (default 1). Use 0 when clients connect directly.
# TRUST_PROXY=1
# Requests per minute per client before 429 (the limiter's default applies when unset).
# API_RATE_LIMIT_MAX_PER_MINUTE=

# --- Web dev server (optional; defaults shown; Vite reads this same repository-root .env) ------------------
# WEB_PORT=24902
# BASE_PATH=/
# API_PROXY_TARGET=http://localhost:8080
# WEB_ALLOWED_HOSTS=

# --- Authentication: Clerk (current; replaced by Better Auth in a later phase) ----------------------------
# Required until Better Auth replaces Clerk: the SPA refuses to load without VITE_CLERK_PUBLISHABLE_KEY and
# the API's Clerk middleware needs well-formed keys. Development-instance keys only (sk_test_ / pk_test_).
CLERK_SECRET_KEY=CHANGE_ME
CLERK_PUBLISHABLE_KEY=CHANGE_ME
VITE_CLERK_PUBLISHABLE_KEY=CHANGE_ME
# Production SPA builds only: https://<app host>/api/__clerk. Leave unset in development.
# VITE_CLERK_PROXY_URL=

# --- Campaign runtime (optional; in-memory coordinator and broker when unset) -----------------------------
# CAMPAIGN_COORDINATOR_MODE=memory
# REDIS_URL is accepted as a fallback name for CAMPAIGN_REDIS_URL.
# CAMPAIGN_REDIS_URL=redis://localhost:6379
# CAMPAIGN_PLATFORM_MAX_TPS=1000
# CAMPAIGN_TRANSPORT_SHARDS=8

# --- WhatsApp / Meta (optional in development; use mock-mode workspaces, never live sends) ----------------
# 32 bytes, base64 or hex. Without it the manual "Connect number" flow answers 503.
# WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
# WHATSAPP_APP_ID=CHANGE_ME
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
# META_APP_SECRET=CHANGE_ME

# --- Campaign media (optional; without it media uploads answer 503) ---------------------------------------
# Choose the backend explicitly: "local" (development and tests; refused in production) or "s3" (an
# S3-compatible bucket such as MinIO; the production backend). A DIR or S3 setting without the selector, or a
# half-configured s3 block, stops the API at startup.
# CAMPAIGN_MEDIA_STORAGE=local
# Absolute path outside the repository (or under the git-ignored .local/).
# CAMPAIGN_MEDIA_STORAGE_DIR=/absolute/path/to/wabista-media
# CAMPAIGN_MEDIA_STORAGE=s3
# Full origin, no path (omit for AWS itself). A custom endpoint defaults to path-style addressing.
# CAMPAIGN_MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
# CAMPAIGN_MEDIA_S3_REGION=us-east-1
# CAMPAIGN_MEDIA_S3_BUCKET=wabista-media
# Key prefix inside the bucket (default campaign-media; empty stores at the bucket root).
# CAMPAIGN_MEDIA_S3_PREFIX=campaign-media
# CAMPAIGN_MEDIA_S3_FORCE_PATH_STYLE=true
# CAMPAIGN_MEDIA_S3_ACCESS_KEY_ID=CHANGE_ME
# CAMPAIGN_MEDIA_S3_SECRET_ACCESS_KEY=CHANGE_ME
