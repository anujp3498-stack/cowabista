{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm run test:unit && pnpm run test:pacing-coordinator && pnpm run test:phone-dispatch-scheduler && pnpm run test:rate-limit && pnpm run test:lifecycle && pnpm run test:planning && pnpm run test:bypass && pnpm run test:frozen-mutation && pnpm run test:plan-preview && pnpm run test:invitations && pnpm run test:cross-tenant && pnpm run test:monitoring && pnpm run test:suppression && pnpm run test:import-download && pnpm run test:contacts-pagination && pnpm run test:campaign-contacts-search && pnpm run test:messages-search && pnpm run test:webhook-failure-backfill && pnpm run test:messages-export && pnpm run test:crash-recovery && pnpm run test:process-crash-handlers && pnpm run test:database-health && pnpm run test:send-fidelity && pnpm run test:multi-template-send-fidelity && pnpm run test:plan-to-send && pnpm run test:duplicate-send-guard && pnpm run test:readiness-endpoint && pnpm run test:parallel-sends && pnpm run test:sustained-tps && pnpm run test:http-hardening && pnpm run test:tps-ceiling",
    "test:unit": "DATABASE_URL=postgresql://test:test@127.0.0.1:1/test tsx --test test/phase4.test.ts",
    "test:rate-limit": "node ./test/build-and-run.mjs",
    "test:pacing-coordinator": "tsx --test test/campaign-pacing-coordinator.test.ts",
    "test:phone-dispatch-scheduler": "tsx --test test/campaign-phone-dispatch-scheduler.test.ts",
    "test:prepared-broker": "node ./test/build-and-run.mjs campaign-prepared-broker.test.ts",
    "test:phone-reservoir": "node ./test/build-and-run.mjs campaign-phone-reservoir.test.ts",
    "test:phone-reservoir-scheduler": "node ./test/build-and-run.mjs campaign-phone-reservoir-scheduler.test.ts",
    "test:settlement-completion": "node ./test/build-and-run.mjs campaign-settlement-completion.test.ts",
    "test:lifecycle": "node ./test/build-and-run.mjs campaign-lifecycle-races.test.ts",
    "test:planning": "node ./test/build-and-run.mjs campaign-planning.test.ts",
    "test:bypass": "node ./test/build-and-run.mjs campaign-lifecycle-bypass.test.ts",
    "test:frozen-mutation": "node ./test/build-and-run.mjs campaign-frozen-template-mutation.test.ts",
    "test:plan-preview": "node ./test/build-and-run.mjs campaign-plan-preview.test.ts",
    "test:invitations": "node ./test/build-and-run.mjs team-invitations.test.ts",
    "test:cross-tenant": "node ./test/build-and-run.mjs cross-tenant-isolation.test.ts",
    "test:monitoring": "node ./test/build-and-run.mjs campaign-monitoring.test.ts",
    "test:suppression": "node ./test/build-and-run.mjs campaign-suppression.test.ts",
    "test:import-download": "node ./test/build-and-run.mjs campaign-import-download.test.ts",
    "test:contacts-pagination": "node ./test/build-and-run.mjs contacts-pagination.test.ts",
    "test:campaign-contacts-search": "node ./test/build-and-run.mjs campaign-contacts-search.test.ts",
    "test:messages-search": "node ./test/build-and-run.mjs campaign-messages-search.test.ts",
    "test:webhook-failure-backfill": "node ./test/build-and-run.mjs campaign-webhook-failure-backfill.test.ts",
    "test:messages-export": "node ./test/build-and-run.mjs campaign-messages-export.test.ts",
    "test:crash-recovery": "node ./test/build-and-run.mjs campaign-worker-crash-recovery.test.ts",
    "test:process-crash-handlers": "node ./test/build-and-run.mjs process-crash-handlers.test.ts",
    "test:database-health": "node ./test/build-and-run.mjs database-health.test.ts",
    "test:send-fidelity": "node ./test/build-and-run.mjs campaign-send-template-fidelity.test.ts",
    "test:multi-template-send-fidelity": "node ./test/build-and-run.mjs campaign-multi-template-send-fidelity.test.ts",
    "test:duplicate-send-guard": "node ./test/build-and-run.mjs campaign-provider-duplicate-send-guard.test.ts",
    "test:readiness-endpoint": "node ./test/build-and-run.mjs campaign-readiness-endpoint.test.ts",
    "test:parallel-sends": "node ./test/build-and-run.mjs campaign-runtime-parallel-sends.test.ts",
    "test:sustained-tps": "node ./test/build-and-run.mjs campaign-sustained-per-number-tps.test.ts",
    "test:http-hardening": "node ./test/build-and-run.mjs http-security-hardening.test.ts",
    "test:plan-to-send": "node ./test/build-and-run.mjs campaign-multi-template-plan-to-send.test.ts",
    "test:tps-ceiling": "node ./test/build-and-run.mjs phone-number-tps-ceiling.test.ts",
    "test:os-crash-recovery": "tsx --test test/campaign-worker-os-crash-recovery.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark:campaign": "node ./benchmark/run.mjs",
    "benchmark:campaign:stepped": "node ./benchmark/stepped-run.mjs",
    "benchmark:campaign:pacing": "node ./benchmark/pacing-study.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@clerk/shared": "^4.30.1",
    "@google-cloud/storage": "^8.0.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
