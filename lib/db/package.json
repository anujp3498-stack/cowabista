{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./auth": "./auth/src/index.ts"
  },
  "scripts": {
    "push": "node --env-file-if-exists=../../.env ./scripts/push.mjs",
    "push-force": "node ./scripts/push.mjs --benchmark-force",
    "apply-sql": "node --env-file-if-exists=../../.env ./scripts/apply-sql.mjs",
    "reset-disposable-local": "node --env-file-if-exists=../../.env ./scripts/reset-disposable-local.mjs",
    "test:guard": "node --test ./scripts/assert-safe-database.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
